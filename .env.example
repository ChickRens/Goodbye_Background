DATABASE_URL_SQLITE = "sqlite://database/usage.db?mode=rwc"
DATABASE_URL_POSTGRES = "postgres://user:password@localhost:5432/goodbye_background"

# ---- 動画切り抜き（TRUSTED_PROXY_HOPS・LOG_CLIENT_IP_DEBUG 以外が 1 つでも欠けると動画の API は 503 VIDEO_CUTOUT_DISABLED）----
# Cloudflare R2（入出力の動画を置く。署名付き URL でブラウザ・ワーカーが直接読み書きする）
R2_ACCOUNT_ID = ""
R2_BUCKET = ""
R2_ACCESS_KEY_ID = ""
R2_SECRET_ACCESS_KEY = ""
# Modal の Web エンドポイントと、プロキシ認証のトークン
MODAL_ENDPOINT_URL = ""
MODAL_KEY = ""
MODAL_SECRET = ""
# ワーカーからの通知の HMAC 鍵（Modal の Secret にも同じ値を置く）
WORKER_CALLBACK_SECRET = ""
# ワーカーが通知を送る先（このサーバーの公開オリジン。例: https://example.com）
PUBLIC_BASE_URL = ""
# 回数制限の IP を X-Forwarded-For の右から何番目で取るか。0 = 接続元（既定）。Cloud Run は本番で確かめて決める（1 の見込み）
TRUSTED_PROXY_HOPS = "0"
# 一時的な確認用: "1" のときだけ POST /video-jobs ごとに [client-ip-debug] の行（生の X-Forwarded-For・接続元・hops・選ばれた IP）を
# ログに出す。それ以外・未設定なら出さない。TRUSTED_PROXY_HOPS を本番で確かめる間だけ付け、確認が終わったら外す（docs/video-cutout-deploy.md の 5）
LOG_CLIENT_IP_DEBUG = ""
